{
	"name": "infinity-careeros",
	"description": "Infinity CareerOS is a free and open-source resume builder and career workspace.",
	"version": "6.0.7",
	"private": true,
	"license": "MIT",
	"author": {
		"name": "Amruth Pillai",
		"email": "amruth@rxresu.me",
		"url": "https://amruthpillai.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/reactive-resume/reactive-resume.git"
	},
	"engines": {
		"node": "24.x"
	},
	"packageManager": "npm@10.9.8",
	"workspaces": [
		"apps/*",
		"packages/*",
		"tooling"
	],
	"scripts": {
		"build": "npm run pdf:translations && turbo run build",
		"check": "npm run pdf:translations && npm run lint:fix && npm run format && npm run lint",
		"lingui:extract": "turbo run lingui:extract --filter=web && npm run pdf:translations",
		"dev": "npm run dev -w web",
		"dev:web": "npm run dev",
		"knip": "knip",
		"start": "npm run start -w web",
		"typecheck": "turbo run typecheck",
		"test": "turbo run test --concurrency=1",
		"test:coverage": "turbo run test:coverage --concurrency=1",
		"test:ci": "turbo run test:ci --concurrency=1",
		"pdf:translations": "npm run pdf:translations -w @reactive-resume/tooling",
		"lint": "vp lint --deny-warnings",
		"lint:fix": "vp lint --fix",
		"lint:agent": "vp lint --deny-warnings --format=agent",
		"format": "vp fmt --write",
		"format:check": "vp fmt --check"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@reactive-resume/config": "*",
		"@shadcn/lint": "^0.2.3",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.8",
		"@types/node": "^26.6.5",
		"@vitest/coverage-v8": "5.0.5",
		"happy-dom": "^21.0.4",
		"knip": "^6.43.0",
		"lefthook": "^2.2.2",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"turbo": "^2.11.10",
		"typescript": "^7.0.2",
		"vite-plus": "1.3.0"
	},
	"overrides": {
		"vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
		"vitest": "5.0.5",
		"next@<16.3.8": "16.3.8",
		"postcss-selector-parser@<7.1.6": "^7.1.6",
		"esbuild@>=0.17.0 <0.28.1": "^0.28.1",
		"postcss@<8.5.10": "^8.5.14",
		"uuid@<11.1.1": "^11.1.1",
		"dompurify@<3.4.17": "^3.4.17",
		"node-forge@<1.4.1": "^1.4.2",
		"zod@>=4.0.0 <4.6.6": "^4.6.7"
	}
}
